# Copy to .env for local runs. No secrets are required; Elexon BMRS is public.
AERIS_ENVIRONMENT=development
AERIS_DATA_MODE=live

# Serve the verified January 2026 snapshot if Elexon cannot be reached.
AERIS_ALLOW_SNAPSHOT_FALLBACK=true
AERIS_CACHE_TTL_SECONDS=21600

# Browser origins allowed to call the API.
AERIS_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8000

AERIS_LOG_LEVEL=INFO

# Optional path overrides.
# AERIS_CACHE_DIR=backend/.cache
# AERIS_SNAPSHOT_PATH=backend/data/elexon-jan-2026.json.gz
# AERIS_STATIC_DIR=static
